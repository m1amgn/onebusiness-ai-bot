{
  "components": {
    "schemas": {
      "AuthRevoked": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "auth.revoked",
            "default": "auth.revoked",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "title": "AuthRevoked",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "RealtimeTicket": {
        "properties": {
          "expires_in": {
            "title": "Expires In",
            "type": "integer"
          },
          "ticket": {
            "title": "Ticket",
            "type": "string"
          }
        },
        "required": [
          "ticket",
          "expires_in"
        ],
        "title": "RealtimeTicket",
        "type": "object"
      },
      "ServerEvent": {
        "discriminator": {
          "mapping": {
            "auth.revoked": "#/components/schemas/AuthRevoked",
            "task.created": "#/components/schemas/TaskCreated",
            "task.deleted": "#/components/schemas/TaskDeleted",
            "task.updated": "#/components/schemas/TaskUpdated"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/TaskCreated"
          },
          {
            "$ref": "#/components/schemas/TaskUpdated"
          },
          {
            "$ref": "#/components/schemas/TaskDeleted"
          },
          {
            "$ref": "#/components/schemas/AuthRevoked"
          }
        ],
        "title": "ServerEvent"
      },
      "TaskCreated": {
        "additionalProperties": false,
        "properties": {
          "task": {
            "$ref": "#/components/schemas/TaskView"
          },
          "type": {
            "const": "task.created",
            "default": "task.created",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "task"
        ],
        "title": "TaskCreated",
        "type": "object"
      },
      "TaskDeleted": {
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "title": "Task Id",
            "type": "integer"
          },
          "type": {
            "const": "task.deleted",
            "default": "task.deleted",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "task_id"
        ],
        "title": "TaskDeleted",
        "type": "object"
      },
      "TaskPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/TaskView"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "TaskPage",
        "type": "object"
      },
      "TaskStatus": {
        "enum": [
          "pending",
          "in_progress",
          "completed"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "TaskStatusChange": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "TaskStatusChange",
        "type": "object"
      },
      "TaskUpdated": {
        "additionalProperties": false,
        "properties": {
          "task": {
            "$ref": "#/components/schemas/TaskView"
          },
          "type": {
            "const": "task.updated",
            "default": "task.updated",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "task"
        ],
        "title": "TaskUpdated",
        "type": "object"
      },
      "TaskView": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "title": "Description",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "inbound_message_id": {
            "title": "Inbound Message Id",
            "type": "integer"
          },
          "position": {
            "title": "Position",
            "type": "integer"
          },
          "source_text": {
            "title": "Source Text",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "title": {
            "maxLength": 120,
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "inbound_message_id",
          "position",
          "title",
          "description",
          "source_text",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "TaskView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "AI Task Bot",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/events": {
      "get": {
        "operationId": "events",
        "parameters": [
          {
            "in": "query",
            "name": "ticket",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ticket"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "properties": {
                    "data": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "schema": {
                  "$ref": "#/components/schemas/ServerEvent"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Events"
      }
    },
    "/api/realtime/tickets": {
      "post": {
        "operationId": "issue_realtime_ticket",
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RealtimeTicket"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Issue Realtime Ticket"
      }
    },
    "/api/tasks": {
      "get": {
        "operationId": "list_tasks",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/TaskStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Tasks"
      }
    },
    "/api/tasks/{task_id}": {
      "patch": {
        "operationId": "change_task_status",
        "parameters": [
          {
            "in": "path",
            "name": "task_id",
            "required": true,
            "schema": {
              "maximum": 2147483647,
              "minimum": 1,
              "title": "Task Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskStatusChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskView"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Change Task Status"
      }
    },
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    }
  }
}
