# Copy to .env; shell variables take precedence. Compose replaces development URLs.
# Set these before the first Compose start. Use letters and digits: they enter a URL.
# Empty values default to taskbot. Changing them does not change an existing volume.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql+asyncpg://taskbot:taskbot@localhost:5432/taskbot
REDIS_URL=redis://localhost:6379/0
# test sessions only; leave empty
REDIS_NAMESPACE=
# Derived from REDIS_URL when unset (broker database 1).
CELERY_BROKER_URL=
TELEGRAM_BOT_TOKEN=
WORKER_ROLE=transcribe
TRANSCRIPTION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
WHISPER_SERVER_URL=http://127.0.0.1:8178
WHISPER_DEV_MODEL_PATH=/absolute/path/to/ggml-large-v3-turbo-q5_0.bin
WHISPER_MODEL=base
# The delivered image supports base. Raise this limit when adding larger models.
WHISPER_MEM_LIMIT=1g
COMPOSE_PROFILES=
TASK_EXTRACTOR=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
WEB_BASE_URL=http://localhost:5173
# Compose publishes only web. Development servers still use 5173 and 8000.
WEB_PORT=8080
LOG_LEVEL=INFO

# Shared infrastructure uses taskbot, 5432 and 6379. To use other ports,
# select an isolated project and update DATABASE_URL and REDIS_URL above.
# TASKBOT_STACK=taskbot-local
# TASKBOT_PG_PORT=15432
# TASKBOT_REDIS_PORT=16379
# PostgreSQL's local development user, password and database are taskbot.
