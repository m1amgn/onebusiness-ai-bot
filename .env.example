# Development values. Copy to .env; shell variables take precedence.
DATABASE_URL=postgresql+asyncpg://taskbot:taskbot@localhost:5432/taskbot
REDIS_URL=redis://localhost:6379/0
# Derived from REDIS_URL when unset (broker database 1).
CELERY_BROKER_URL=
TELEGRAM_BOT_TOKEN=
WORKER_ROLE=transcribe
TRANSCRIPTION_PROVIDER=whisper_server
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
WHISPER_SERVER_URL=http://127.0.0.1:8178
WHISPER_DEV_MODEL_PATH=/absolute/path/to/ggml-large-v3-turbo-q5_0.bin
WHISPER_MODEL=base
COMPOSE_PROFILES=
TASK_EXTRACTOR=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
WEB_BASE_URL=http://localhost:5173
# Reserved for the delivered application stack; S1 dev servers use fixed ports.
API_PORT=8000
WEB_PORT=5173
LOG_LEVEL=INFO

# Shared infrastructure uses taskbot, 5432 and 6379. To use other ports,
# select an isolated project and update DATABASE_URL and REDIS_URL above.
# TASKBOT_STACK=taskbot-local
# TASKBOT_PG_PORT=15432
# TASKBOT_REDIS_PORT=16379
# PostgreSQL's local development user, password and database are taskbot.
